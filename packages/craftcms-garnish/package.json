{
  "name": "@craftcms/garnish",
  "version": "0.0.0",
  "description": "Modern, tree-shakeable TypeScript rewrite of Craft CMS's Garnish UI library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftcms/npm-packages.git"
  },
  "keywords": [
    "craftcms",
    "garnish",
    "ui"
  ],
  "scripts": {
    "build": "vp pack",
    "build:watch": "vp pack --watch",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vp test run",
    "test:dev": "vp test",
    "test:coverage": "vp test run --coverage",
    "format": "vp fmt ./src ./tests ./stories ./.storybook",
    "check:format": "vp fmt --check ./src ./tests ./stories ./.storybook",
    "check:types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run check:types && pnpm run check:format"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "development": "./src/compat.ts",
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "jquery": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    }
  },
  "author": "Pixel & Tonic, Inc. <support@pixelandtonic.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/craftcms/npm-packages/issues"
  },
  "homepage": "https://github.com/craftcms/npm-packages#readme",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/html-vite": "^10.5.5",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.9.0",
    "storybook": "^10.5.5",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10",
    "vite-plus": "0.2.6"
  }
}
