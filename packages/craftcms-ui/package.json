{
  "name": "@craftcms/ui",
  "version": "0.0.0",
  "description": "CP Components for Craft CMS",
  "type": "module",
  "main": "./dist/cp.mjs",
  "types": "./dist/cp.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftcms/npm-packages.git"
  },
  "keywords": [
    "craftcms",
    "cp",
    "web-components"
  ],
  "scripts": {
    "test": "vp test run",
    "test:dev": "vp test",
    "test:coverage": "vp test run --coverage",
    "dev": "node ./scripts/build.js --develop",
    "prebuild": "npm run format",
    "build": "node ./scripts/build.js",
    "format": "vp fmt --write ./src",
    "check:format": "vp fmt --check ./src",
    "check:exports": "attw --pack .",
    "check:types": "tsc --noEmit",
    "prestorybook": "npm run build:manifest",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "npm run build:manifest",
    "build:storybook": "storybook build",
    "build:manifest": "custom-elements-manifest analyze --litelement --outdir dist",
    "generate:vue-wrappers": "node ./scripts/generate-vue-wrappers.js",
    "generate:colors": "node ./scripts/generate-colors.js && node scripts/generate-color-palette.js && node ./scripts/generate-tailwind.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/cp.d.mts",
      "import": "./dist/cp.mjs"
    },
    "./components/*": {
      "development": "./src/components/*.ts",
      "default": "./dist/components/*.ts.mjs"
    },
    "./core": {
      "development": "./src/core/element-selector/index.ts",
      "types": "./dist/core/element-selector/index.ts.d.mts",
      "import": "./dist/core/element-selector/index.ts.mjs"
    },
    "./core/*": {
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.ts.mjs"
    },
    "./services/*": {
      "development": "./src/services/*.ts",
      "default": "./dist/services/*.ts.mjs"
    },
    "./utilities/*": {
      "development": "./src/utilities/*.ts",
      "default": "./dist/utilities/*.ts.mjs"
    },
    "./factory": {
      "development": "./src/factory/index.ts",
      "types": "./dist/factory/index.ts.d.mts",
      "import": "./dist/factory/index.ts.mjs"
    },
    "./factory/*": {
      "development": "./src/factory/*.ts",
      "default": "./dist/factory/*.ts.mjs"
    },
    "./styles/*": {
      "development": "./src/styles/*",
      "default": "./dist/styles/*"
    },
    "./vue/*": "./dist/vue/*",
    "./types/*": "./src/types/*",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./tailwind.css": "./tailwind.css",
    "./dist/*": "./dist/*",
    "./*": "./dist/*"
  },
  "author": "Pixel & Tonic, Inc. <support@pixelandtonic.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/craftcms/npm-packages/issues"
  },
  "homepage": "https://github.com/craftcms/npm-packages#readme",
  "peerDependencies": {
    "@lion/ui": "0.x",
    "lit": "3.x"
  },
  "devDependencies": {
    "@adobe/leonardo-contrast-colors": "^1.1.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lion/ui": "^0.16.1",
    "@shoelace-style/shoelace": "^2.20.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/web-components-vite": "^10.5.5",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/humanize-duration": "^3.27.4",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.10",
    "@wc-toolkit/storybook-helpers": "^10.3.0",
    "del": "^8.0.1",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.0",
    "globby": "^16.2.0",
    "happy-dom": "^20.9.0",
    "humanize-duration": "^3.33.2",
    "lit": "^3.3.2",
    "ora": "^9.4.0",
    "playwright": "^1.59.1",
    "plop": "^4.0.5",
    "recursive-copy": "^2.0.14",
    "rimraf": "^6.1.3",
    "storybook": "^10.5.5",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plugin-dts": "^5.0.0",
    "vite-plus": "0.2.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@formatjs/intl-durationformat": "^0.10.8",
    "@github/combobox-nav": "^3.0.2",
    "@github/relative-time-element": "^5.0.0",
    "@popperjs/core": "^2.11.8",
    "@simplewebauthn/browser": "^13.3.0",
    "@vitest/browser-playwright": "4.1.10",
    "axios": "^1.17.0",
    "dom-input-range": "^2.0.1",
    "inputmask": "^5.0.10"
  },
  "customElements": "dist/custom-elements.json"
}
