{
  "extends": "@total-typescript/tsconfig/bundler/dom/app",
  "compilerOptions": {
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./resources/js/*"],
      "@actions/*": ["./resources/js/actions/CraftCms/Cms/Http/Controllers/*"],
      "@icons/*": ["./cms-assets/resources/icons/*"],
      "@public/*": ["./resources/public/*"],
      "@routes/*": ["./resources/js/routes/craft/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.d.ts",
    "resources/js/**/*.vue",
    "tests/TestClasses/TestPlugin/resources/js/**/*.ts",
    "tests/TestClasses/TestPlugin/resources/js/**/*.vue",
    "workbench/resources/js/**/*.ts",
    "workbench/resources/js/**/*.vue",
    "yii2-adapter/resources/js/**/*.ts",
    "yii2-adapter/resources/js/**/*.vue"
  ],
  "exclude": ["node_modules"]
}
