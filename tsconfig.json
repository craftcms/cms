{
  "extends": "@total-typescript/tsconfig/bundler/dom/app",
  "compilerOptions": {
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./resources/js/*"],
      "@actions/*": ["./resources/js/actions/CraftCms/Cms/Http/Controllers/*"],
      "@craftcms/cp/vue/*": ["./node_modules/@craftcms/cp/dist/vue/*"],
      "@icons/*": ["./resources/icons/*"],
      "@public/*": ["./resources/public/*"],
      "@routes/*": ["./resources/js/routes/craft/*"],
    },
    "types": ["vite/client"]
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.d.ts",
    "resources/js/**/*.vue"
  ],
  "exclude": [
    "node_modules"
  ]
}
