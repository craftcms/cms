{
  "name": "craftcms",
  "private": true,
  "main": "webpack.config.js",
  "type": "module",
  "scripts": {
    "check-prettier": "vp fmt --check ./resources",
    "fix-prettier": "vp fmt ./resources",
    "prepare": "vp config",
    "prebuild": "pnpm run fix-prettier",
    "build": "vp build",
    "build:fe": "pnpm run build:ui && pnpm run build",
    "predev": "node scripts/ensure-built.mjs",
    "dev": "run-p -l dev:vite dev:ui",
    "dev:vite": "vp dev",
    "predev:legacy": "node scripts/ensure-built.mjs",
    "dev:legacy": "run-p -l dev:vite dev:ui dev:bundles",
    "lint:js": "vp lint resources/js/",
    "lint:styles": "stylelint \"resources/**/*.css\"",
    "generate:types": "./vendor/bin/testbench typescript:transform",
    "generate:wayfinder": "./vendor/bin/testbench wayfinder:generate --path resources/js",
    "typecheck": "vue-tsc --noEmit",
    "lint": "pnpm run lint:js && pnpm run lint:styles && pnpm run typecheck",
    "build:bundles": "pnpm --filter @craftcms/legacy run build",
    "dev:bundles": "pnpm --filter @craftcms/legacy run dev",
    "serve:bundles": "pnpm --filter @craftcms/legacy run serve",
    "dev:ui": "pnpm --filter @craftcms/ui run dev",
    "build:ui": "pnpm --filter @craftcms/ui run build",
    "build:garnish": "pnpm --filter @craftcms/garnish run build",
    "test": "vp test run",
    "test:ui": "pnpm --filter @craftcms/ui run test",
    "storybook": "storybook dev -p 6007",
    "build:storybook": "storybook build",
    "storybook:ui": "pnpm --filter @craftcms/ui run storybook",
    "build:all": "pnpm run build:garnish && pnpm run build:ui && pnpm run build:bundles && pnpm run build"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@craftcms/garnish": "workspace:*",
    "@craftcms/playwright": "workspace:*",
    "@craftcms/webpack": "workspace:*",
    "@laravel/vite-plugin-wayfinder": "^0.1.7",
    "@playwright/test": "catalog:",
    "@types/jquery": "^3.5.34",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/vue3-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.2.4",
    "@total-typescript/tsconfig": "catalog:",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "catalog:",
    "jquery": "catalog:",
    "npm-run-all": "^4.1.5",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-prettier": "catalog:",
    "stylelint-use-logical": "^2.1.3",
    "stylelint-use-logical-spec": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10",
    "vue-tsc": "^3.2.7",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@awesome.me/kit-ddaed3f5c5": "^1.0.74"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@craftcms/ui": "workspace:*",
    "@craftcms/graphiql": "workspace:*",
    "@headlessui/vue": "^1.7.23",
    "@lion/ui": "catalog:",
    "@inertiajs/core": "^3.0.3",
    "@inertiajs/vite": "^3.0.3",
    "@inertiajs/vue3": "^3.0.3",
    "@simplewebauthn/browser": "catalog:",
    "@tanstack/table-core": "^8.21.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "axios": "catalog:",
    "d3": "catalog:",
    "laravel-vite-plugin": "^3.1.0",
    "lit": "catalog:",
    "overtype": "^2.4.0",
    "punycode": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  }
}
