# Baseline whitespace rules for every editor. Actual formatting is done by
# `vp fmt` (JS/TS/Vue/CSS/JSON/YAML/HTML, configured in the `fmt` block of
# vite.config.js) and Pint/ECS (PHP).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,mjs,cjs,ts,mts,cts,vue,css,scss,json,jsonc,yml,yaml,html}]
indent_size = 2

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
