# Running webpack-dev-server from host
DEV_SERVER_PUBLIC=http://localhost:8085/
DEV_SERVER_PORT=8085
DEV_SERVER_LOOPBACK=http://host.docker.internal:8085
# DEV_SERVER_HOST=127.0.0.1 # you might needed it if you have a problem with hot reloads not working

# Running webpack-dev-server within container
# DEV_SERVER_PUBLIC=http://my-project.tld:3000/
# DEV_SERVER_PORT=3000
# DEV_SERVER_HOST=0.0.0.0
# DEV_SERVER_LOOPBACK=http://0.0.0.0:3000

# Used to tell Vite where you're loading your assets from
APP_URL=

# Point vite to your ddev certificates. Must be absolute paths
VITE_SERVER_HTTPS_PATH_KEY=$HOME/path/to/.ddev/traefik/certs/{site}.key
VITE_SERVER_HTTPS_PATH_CERT=$HOME/path/to/.ddev/traefik/certs/{site}.crt
