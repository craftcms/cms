@fortawesome:registry=https://npm.fontawesome.com/
@awesome.me:registry=https://npm.fontawesome.com/

# The Font Awesome auth token deliberately lives OUTSIDE this file. pnpm refuses
# to expand environment variables in registry credentials read from a
# project-level .npmrc (it's committed, so a bad registry entry could exfiltrate
# the secret). Store it once in pnpm's own credential file instead:
#
#   pnpm config set "//npm.fontawesome.com/:_authToken" "$CRAFT_FONTAWESOME_TOKEN"
#
# (that writes to pnpm's auth store, e.g. ~/Library/Preferences/pnpm/auth.ini on
# macOS — never to this file). Without it, the optional `@awesome.me/*` kit
# dependency is skipped.
