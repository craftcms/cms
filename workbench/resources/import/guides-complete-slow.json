                "type": "guideTip",
                "body": "Use DDEV for a local environment.",
                "tone": "tip"
              },
              {
                "type": "guideTip",
                "body": "Back up before upgrading.",
                "tone": "warning"
              }
            ]
          },
          {
            "type": "guideCallout",
            "tone": "information",
            "body": "The installer asks for your database credentials."
          },
          {
            "type": "guideStep",
