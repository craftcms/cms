        "type": "guideCode",
        "title": "An entry template",
        "language": "twig",
        "code": "{% extends '_layout' %}\n\n{% block content %}\n  {{ entry.title }}\n{% endblock %}"
      },
      {
        "type": "guideCallout",
        "tone": "warning",
        "body": "Escape anything a user can type."
      },
      {
        "type": "guideStepGroup",
