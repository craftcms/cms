<!doctype html>
<html lang="{{ currentSite.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ siteName }}{% endblock %}</title>
  <style>
    body { margin: 0; font: 18px/1.6 system-ui, sans-serif; color: #1f2937; }
    header, main { max-width: 46rem; margin: 0 auto; padding: 1.5rem; }
    header { border-bottom: 1px solid #e5e7eb; }
    header a { color: inherit; text-decoration: none; font-weight: 600; }
    h1 { font-size: 2.25rem; line-height: 1.2; margin: 0 0 .5rem; }
    h2 { font-size: 1.25rem; margin: 2.5rem 0 1rem; padding-bottom: .25rem; border-bottom: 1px solid #e5e7eb; }
    time, .muted { color: #6b7280; }
    dl { display: grid; grid-template-columns: 11rem 1fr; gap: .75rem 1.5rem; margin: 0; }
    dt { font-weight: 600; font-size: .875rem; color: #4b5563; padding-top: .15rem; }
    dd { margin: 0; min-width: 0; }
    dd > :first-child { margin-top: 0; } dd > :last-child { margin-bottom: 0; }
    .swatch { display: inline-block; width: 1em; height: 1em; border-radius: 3px; vertical-align: -.15em; margin-right: .4em; }
    .card { border: 1px solid #e5e7eb; border-radius: 6px; padding: .75rem 1rem; margin-bottom: .75rem; }
    .callout { background: #eff6ff; border-color: #bfdbfe; }
    table { border-collapse: collapse; } th, td { border: 1px solid #e5e7eb; padding: .25rem .75rem; text-align: left; }
    pre { background: #f3f4f6; padding: .75rem 1rem; border-radius: 6px; overflow: auto; font-size: .85rem; }
    img { max-width: 100%; height: auto; border-radius: 6px; }
  </style>
</head>
<body>
  <header><a href="{{ siteUrl }}">{{ siteName }}</a></header>
  <main>{% block content %}{% endblock %}</main>
</body>
</html>
