{
  "yii2-adapter/**/*.php": [
    "./yii2-adapter/vendor/bin/ecs check --config ./yii2-adapter/ecs.php --ansi --fix"
  ],
  "!(yii2-adapter)/**/*.php": ["./vendor/bin/pint --parallel"],
  "*.scss": ["stylelint --fix --allow-empty-input"],
  "*.{html,json,css,scss}": "prettier --ignore-unknown --write"
}
