{% import '_includes/forms.twig' as forms %}

<h2>{{ 'New token'|t('app') }}</h2>

{{ forms.textField({
  label: 'Name'|t('app'),
  instructions: 'What this token will be used for.'|t('app'),
  id: 'name',
  name: 'name',
  maxlength: 255,
  required: true,
  autofocus: true,
  data: {'error-key': 'name'},
}) }}

{% if resources|length > 1 %}
  {{ forms.selectField({
    label: 'API'|t('app'),
    id: 'resource',
    name: 'resource',
    options: resources|map(resource => {label: resource.getLabel(), value: resource.id})|values,
    toggle: true,
    targetPrefix: 'scopes-',
  }) }}
{% else %}
  {{ hiddenInput('resource', (resources|first).id) }}
{% endif %}

{% for resource in resources %}
  <div id="scopes-{{ resource.id }}"{% if not loop.first %} class="hidden"{% endif %}>
    {{ forms.checkboxGroupField({
      label: 'Scopes'|t('app'),
      instructions: resources|length > 1 ? null : resource.getLabel(),
      name: "scopes[#{resource.id}]",
      options: scopes[resource.id]|map(scope => {label: resource.scopes[scope], value: scope}),
      required: true,
      data: {'error-key': 'scopes'},
    }) }}
  </div>
{% endfor %}

{{ forms.selectField({
  label: 'Expiration'|t('app'),
  id: 'expiresIn',
  name: 'expiresIn',
  options: [
    {label: '7 days'|t('app'), value: 7},
    {label: '30 days'|t('app'), value: 30},
    {label: '90 days'|t('app'), value: 90},
    {label: '1 year'|t('app'), value: 365},
  ],
  value: 30,
}) }}
