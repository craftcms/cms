{% extends '_layouts/basecp.twig' %}
{% set title = 'Authorize MCP client'|t('app') %}
{% set bodyClass = 'login' %}

{% block body %}
  <main class="message-container">
    <h1>{{ title }}</h1>
    <p>{{ '{client} would like to access Craft CMS as you.'|t('app', {client: clientName}) }}</p>
    <p>{{ 'This client can use Craft MCP to read and change content and settings within your permissions.'|t('app') }}</p>
    <form method="post" action="{{ approveAction }}">
      {{ csrfInput() }}
      {{ hiddenInput('authToken', authToken) }}
      <button class="btn submit" type="submit">{{ 'Authorize'|t('app') }}</button>
      <button class="btn" type="submit" formaction="{{ denyAction }}">{{ 'Deny'|t('app') }}</button>
    </form>
  </main>
{% endblock %}
