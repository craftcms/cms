{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}
{% set title = 'MCP'|t('app') %}
{% set selectedSubnavItem = 'settings' %}
{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}
{% set crumbs = [{label: 'Settings'|t('app'), url: url('settings')}] %}

{% macro notice(id, type, label, message, show) %}
    <p id="{{ id }}" class="{{ type }} has-icon{% if not show %} hidden{% endif %}">
        <span class="icon" aria-hidden="true"></span>
        <span class="visually-hidden">{{ label }} </span>
        <span>{{ message }}</span>
    </p>
{% endmacro %}

{% block content %}
    {% if readOnly %}{% set contentNotice = readOnlyNotice() %}{% endif %}
    {% if not readOnly %}
        {{ actionInput('mcp-settings/save') }}
        {{ redirectInput('settings/mcp') }}
    {% endif %}

    <h2>{{ 'Authenticated MCP server'|t('app') }}</h2>
    <p>{{ 'Lets MCP clients act as a Craft user after the user signs in and approves access. Any active user can sign in. Tools still check their permissions.'|t('app') }}</p>
    {{ forms.lightswitchField({label: 'Enable the authenticated MCP server'|t('app'), id: 'mcp-enabled', name: 'settings[enabled]', on: settings.enabled, disabled: readOnly, errors: settings.getErrors('enabled')}) }}
    {{ forms.textField({label: 'Endpoint'|t('app'), id: 'mcp-route', instructions: 'The path MCP clients connect to, such as `/mcp`.'|t('app'), name: 'settings[route]', value: settings.route, required: true, disabled: readOnly, class: 'code', errors: settings.getErrors('route')}) }}
    {{ _self.notice('mcp-route-cp', 'notice', 'Tip:'|t('app'), 'This endpoint is in the control panel, so only users with control panel access can use it.'|t('app'), settings.isCpRoute(settings.route)) }}
    {{ forms.textField({label: 'Authorization Endpoint'|t('app'), id: 'mcp-authorization-route', instructions: 'The path to give MCP clients that sign in with OAuth. It always requires an access token, so clients can discover how to sign in.'|t('app'), name: 'settings[authorizationRoute]', value: settings.authorizationRoute, required: true, disabled: readOnly, class: 'code', errors: settings.getErrors('authorizationRoute')}) }}
    <p>{{ 'Local clients can connect through `php craft mcp/serve --user=…`.'|t('app')|md(inlineOnly=true) }}</p>

    <hr>

    <h2>{{ 'Public MCP server'|t('app') }}</h2>
    <p>{{ 'Lets anyone use the tools and content you approve below, without signing in.'|t('app') }}</p>
    {{ forms.lightswitchField({label: 'Enable the public MCP server'|t('app'), id: 'mcp-public-enabled', name: 'settings[publicEnabled]', on: settings.publicEnabled, disabled: readOnly, errors: settings.getErrors('publicEnabled')}) }}
    {{ forms.textField({label: 'Endpoint'|t('app'), id: 'mcp-public-route', instructions: 'The path public MCP clients connect to, such as `/mcp`.'|t('app'), name: 'settings[publicRoute]', value: settings.publicRoute, required: true, disabled: readOnly, class: 'code', errors: settings.getErrors('publicRoute')}) }}
    {{ _self.notice('mcp-shared-route', 'warning', 'Warning:'|t('app'), 'The authenticated server uses this endpoint too. Requests without an access token go to the public server, so MCP clients can’t discover how to sign in at this endpoint.'|t('app'), settings.enabled and settings.publicEnabled and settings.route|trim('/') == settings.publicRoute|trim('/')) }}

    {% set labels = {
        publicSiteHandles: 'Sites', publicSectionHandles: 'Sections', publicNestedEntryFieldHandles: 'Nested entry fields', publicVolumeHandles: 'Volumes', publicUserGroupHandles: 'User groups', publicElementTypes: 'Other element types',
        publicTools: 'Tools', publicResources: 'Resources', publicResourceTemplates: 'Resource templates', publicPrompts: 'Prompts'
    } %}
    <h3>{{ 'Public content sources'|t('app') }}</h3>
    {% for attribute, options in scopes %}
        {{ forms.checkboxGroupField({label: labels[attribute]|t('app'), name: 'settings['~attribute~']', options: options, values: attribute(settings, attribute), disabled: readOnly, errors: settings.getErrors(attribute)}) }}
    {% endfor %}
    {% for attribute, label in {publicAllowDrafts: 'Allow drafts', publicAllowRevisions: 'Allow revisions', publicAllowInactive: 'Allow inactive content'} %}
        {{ forms.lightswitchField({label: label|t('app'), name: 'settings['~attribute~']', on: attribute(settings, attribute), disabled: readOnly}) }}
    {% endfor %}

    <h3>{{ 'Public capabilities'|t('app') }}</h3>
    {% for attribute, options in capabilities %}
        {{ forms.checkboxGroupField({label: labels[attribute]|t('app'), name: 'settings['~attribute~']', options: options, values: attribute(settings, attribute), disabled: readOnly, errors: settings.getErrors(attribute)}) }}
    {% endfor %}
{% endblock %}

{% js %}
    (() => {
        const cpTrigger = {{ craft.app.config.general.cpTrigger|json_encode|raw }};
        const trim = (value) => value.replace(/^\/+|\/+$/g, '');
        const route = document.getElementById('mcp-route');
        const authorizationRoute = document.getElementById('mcp-authorization-route');
        const publicRoute = document.getElementById('mcp-public-route');
        const enabled = (name) => document.querySelector(`input[name="settings[${name}]"]`)?.value === '1';

        const update = () => {
            const path = trim(route.value);
            document.getElementById('mcp-route-cp').classList.toggle('hidden', !cpTrigger || !`${path}/`.startsWith(`${cpTrigger}/`));
            document.getElementById('mcp-shared-route').classList.toggle('hidden', !enabled('enabled') || !enabled('publicEnabled') || path !== trim(publicRoute.value));
        };

        // While the authorization endpoint starts with the endpoint, keep the rest of it after the endpoint.
        let suffix;
        const captureSuffix = () => {
            suffix = route.value !== '' && authorizationRoute.value.startsWith(route.value)
                ? authorizationRoute.value.slice(route.value.length)
                : null;
        };
        captureSuffix();
        authorizationRoute.addEventListener('input', captureSuffix);
        route.addEventListener('input', () => {
            if (suffix !== null) {
                authorizationRoute.value = route.value + suffix;
            }
            update();
        });
        publicRoute.addEventListener('input', update);
        $('#mcp-enabled, #mcp-public-enabled').on('change', update);
    })();
{% endjs %}
