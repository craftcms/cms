{% extends '_layouts/message' %}
{% set title = 'License purchase required.'|t('app') %}
{% set includePane = false %}
{% set wide = true %}

{% block message %}
  <craft-pane id="licensing-issues" label="{{ title }}" heading-level="1">
    <div class="prose grid gap-md">
      <p>
        {{ 'The following licensing {total, plural, =1{issue} other{issues}} can be resolved with a single purchase on Craft Console:'|t('app', {
          total: issues|length,
        }) }}
      </p>

      <ul>
        {% for issue in issues %}
          <li>{{ issue[1] }}</li>
        {% endfor %}
      </ul>

      <p>
        {{ 'Not ready to buy? <a href="{url}">Try before buying</a>.'|t('app', {
          url: 'https://craftcms.com/knowledge-base/how-to-trial-craft-cms-and-plugin-editions',
        })|raw }}
      </p>
    </div>

    <craft-button slot="secondary-action" id="refresh-btn" type="button" icon="arrows-rotate">
      {{ 'Refresh'|t('app') }}
    </craft-button>
    <craft-button
      slot="primary-action"
      variant="primary"
      href="{{ cartUrl }}"
      target="_blank"
      icon="arrow-up-right-from-square"
      icon-position="suffix"
    >
      {{ 'Resolve now'|t('app') }}
      <span class="sr-only">{{ 'Opens in a new window'|t('app') }}</span>
    </craft-button>
  </craft-pane>

  <p id="continue" class="mt-lg text-center text-(--c-text-quiet)" role="timer"
     data-licensing-continue="{{ duration }}" data-licensing-hash="{{ hash }}"></p>
{% endblock %}
