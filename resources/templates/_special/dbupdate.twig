{% extends "_layouts/message" %}
{% set title = "Complete the Update"|t('app') %}

{% block message %}
    <p>{{ "To complete the update, some changes must be made to your database."|t('app') }}</p>
    <form method="post" action="{{ cpUrl('updates') }}" class="buttons">
        {{ csrfInput() }}
        {{ hiddenInput('return', Request.path()) }}
      <craft-button type="submit" variant="primary">{{ 'Finish up'|t('app') }}</craft-button>
    </form>
{% endblock %}
