{% extends "_layouts/message" %}
{% set title = "Complete the Update"|t('app') %}
{% set includePane = false %}

{% block message %}
  <form method="post" action="{{ cpUrl('updates') }}">
    <craft-pane>
      <p>{{ "To complete the update, some changes must be made to your database."|t('app') }}</p>
      {{ csrfInput() }}
      {{ hiddenInput('return', Request.path()) }}

      <craft-button slot="primary-action" type="submit" variant="primary">{{ 'Finish up'|t('app') }}</craft-button>
    </craft-pane>
  </form>
{% endblock %}
