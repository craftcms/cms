{% set icon = null %}
{% set iconUrl = iconUrl ?? null %}
{% set iconSvg = iconSvg ?? null %}
{% set action = action ?? null %}
{% set formId = formId is defined ? formId : 'x' %}

{% if pluginName and (iconUrl or iconSvg) %}
    {% set icon %}
        {% if iconUrl %}
            <img src="{{ iconUrl }}" alt="">
        {% else %}
            {{ svg(iconSvg, sanitize=true, namespace=true) }}
        {% endif %}
    {% endset %}
{% endif %}

{% set actionHtml = null %}

{% if action %}
    {% set actionHtml %}
        {% if action.method == 'post' %}
            <button type="submit" class="btn"{% if formId %} form="{{ formId }}"{% endif %} formaction="{{ action.url }}">{{ action.label }}</button>
        {% else %}
            <a class="btn" href="{{ action.url }}">{{ action.label }}</a>
        {% endif %}
    {% endset %}
{% endif %}

{{ ui('missing-component', {
    error,
    pluginName,
    icon,
    action: actionHtml,
    attributes: attributes ?? {},
}) }}
