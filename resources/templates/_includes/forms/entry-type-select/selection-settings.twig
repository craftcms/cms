{% import '_includes/forms' as forms %}

{% set chipId = "chip#{random()}" %}
<div class="cp:p-2 cp:border cp:rounded cp:bg-gray-100">
  {{ chip(entryType.original, {
    id: chipId,
    class: 'hairline',
    showActionMenu: true,
    showHandle: true,
    hyperlink: false,
  }) }}
</div>

{% js %}
(() => {
  $(document).on('dblclick taphold', '#{{chipId|namespaceInputId}}', (ev) => {
    $(ev.currentTarget).find('[data-edit-action]').first().click();
  });
})();
{% endjs %}

{{ forms.textField({
  label: 'Name'|t('app'),
  id: 'name',
  name: 'name',
  value: old('name', entryType.name != entryType.original.name ? entryType.name : null),
  placeholder: entryType.original.name,
  errors: errors.get('name'),
  data: {
    'error-key': 'name',
  },
}) }}

{{ forms.textField({
  label: 'Handle'|t('app'),
  id: 'handle',
  name: 'handle',
  class: 'code',
  autocorrect: false,
  autocapitalize: false,
  maxlength: 64,
  value: old('handle', entryType.handle != entryType.original.handle ? entryType.handle : null),
  placeholder: entryType.original.handle,
  errors: errors.get('handle'),
  data: {
    'error-key': 'handle'
  },
}) }}

{{ forms.textareaField({
  label: 'Description'|t('app'),
  id: 'description',
  class: 'nicetext',
  name: 'description',
  value: old('description', entryType.description != entryType.original.description ? entryType.description : null),
  placeholder: entryType.original.description,
  errors: errors.get('description'),
  data: {
    'error-key': 'description',
  },
}) }}
