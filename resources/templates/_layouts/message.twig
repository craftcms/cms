{% extends "_layouts/base" %}
{% set bodyClass = 'message' %}
{% set includePane = includePane ?? true %}
{% set wide = wide ?? false %}
{% set message = block('message') %}

{% block body %}
  <main class="message-container grid min-h-dvh place-items-center p-(--cp-container-padding)">
    <div class="w-full {{ wide ? 'max-w-md' : 'max-w-sm' }}">
      {% if includePane %}
        <craft-pane>
          {{ message | raw }}
        </craft-pane>
      {% else %}
        {{ message | raw }}
      {% endif %}
    </div>
  </main>
{% endblock %}
