{% if craft.cp.areAlertsCached() %}
  {% set alerts = craft.cp.getAlerts() %}
  {% if alerts %}
    {% embed '_layouts/components/tag.twig' with {
      alerts: alerts,
      type: 'ul',
      attributes: {
        id: 'alerts',
      },
      style: {
        'display': 'block',
        'position': 'relative',
        'background-color': 'var(--red-050)',
        'border-left': '6px solid var(--error-color)',
        'color': 'var(--error-color)',
      },
    } only %}
      {% block content %}
        {% for alert in alerts %}
          {% embed '_layouts/components/tag.twig' with {
            alert,
            type: 'li',
            style: {
              'display': 'flex',
              'min-height': 'var(--cp-header-height)'
            },
          } only %}
            {% block content %}
              {% embed '_layouts/components/tag.twig' with {
                alert,
                type: 'div',
                style: {
                  'display': 'block',
                },
              } only %}
                {% block content %}
                  {% if alert is string or (alert.showIcon ?? true) %}
                    {% include '_layouts/components/tag.twig' with {
                      type: 'craft-icon',
                      attributes: {
                        name: 'alert',
                        label: 'Error'|t('app'),
                      },
                    } only %}
                  {% endif %}
                  {% if alert.title ?? false %}
                    {% include '_layouts/components/tag.twig' with {
                      type: 'h2',
                      style: {display: 'block'},
                      content: alert.title|e,
                    } only %}
                  {% endif %}
                  {{ (alert is array ? alert.content : alert)|raw }}
                  {% if (alert.actions ?? false) or (alert.refreshable ?? false) %}
                    {% embed '_layouts/components/tag.twig' with {
                      alert,
                      type: 'p',
                      attributes: {
                        class: ['flex', 'flex-nowrap', (alert.refreshable ?? false) ? 'resolvable-alert-buttons']|filter,
                      },
                      style: {display: 'block'},
                    } only %}
                      {% block content %}
                        {% for action in alert.actions ?? [] %}
                          {% include '_layouts/components/tag.twig' with {
                            type: 'craft-button',
                            attributes: {
                              href: action.url,
                              variant: 'outline',
                              size: 'small',
                              inherit: true,
                            },
                            style: {display: 'inline-flex'},
                            content: action.label|e,
                          } only %}
                        {% endfor %}
                      {% endblock %}
                    {% endembed %}
                  {% endif %}
                {% endblock %}
              {% endembed %}
            {% endblock %}
          {% endembed %}
        {% endfor %}
      {% endblock %}
    {% endembed %}
  {% endif %}
{% else %}
  {% js %}
    Craft.cp?.fetchAlerts().then(alerts => {
      Craft.cp.displayAlerts(alerts);
    });
  {% endjs %}
{% endif %}
