{% set containerId = "asset-image-preview#{random()}" %}
{% set toggleId = "toggle-focal#{random()}" %}
{% set enableFocalPoint = (
  asset.mimeType != 'image/svg+xml' and
  can('save', asset)
) %}
{% set editFocal = enableFocalPoint and editFocal|default(false) %}

{% if editFocal %}
    {# The preview modal moves this into its footer #}
    <craft-button id="{{ toggleId }}" slot="footer" class="me-auto" type="button" icon="crosshairs" toggle>
        {{- 'Focal Point'|t('app') -}}
    </craft-button>
{% endif %}

<div id="{{ containerId }}" class="asset-image-preview relative">
    {{ tag('img', {
        src: url,
        width: asset.width,
        height: asset.height,
        alt: asset.alt,
        data: {
            uid: asset.uid,
            focal: asset.focalPoint|join(';'),
            maxWidth: asset.width,
            maxHeight: asset.height,
        },
        style: asset.placeholderDataUrl ? {
            background: "url(#{asset.placeholderDataUrl}) center / 100% 100% no-repeat",
        } : false,
        onload: "this.style.background = ''; setTimeout(Craft.PreviewFileModal.resizePreviewImage, 100)",
    }) }}
</div>

{% do registerLegacyAsset("CraftCms\\Cms\\View\\LegacyAssets\\FocalPointAsset") %}

{% if enableFocalPoint %}
  {% js %}
    (() => {
      if (window.imageFocalPoint) {
        window.imageFocalPoint.destruct();
        delete window.imageFocalPoint;
      }

      const $container = $('#{{ containerId }}');
      if ($container.length) {
        window.imageFocalPoint = new Craft.FocalPoint($container, $('#{{ toggleId }}'), {{ editFocal ? 'true' : 'false' }});
      }
    })();
  {% endjs %}
{% endif %}
