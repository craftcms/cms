{% import '_includes/forms.twig' as forms %}

{% set static = static ?? false %}
{% set readOnly = readOnly ?? (static == true) %}

{% set errors = errors ?? [] %}

{{ forms.textField({
    label: "Data File"|t('app'),
    instructions: "The absolute path to the file containing the data you want to import."|t('app'),
    id: 'file',
    name: 'file',
    class: 'code',
    value: old('settings.file', import.file),
    required: true,
    errors: errors.get('settings.file'),
    data: {'error-key': 'settings.file'},
    disabled: readOnly,
    placeholder: '@root/resources/my-data.json',
    static: static,
}) }}

{{ forms.selectField({
    id: 'site',
    name: 'site',
    label: 'Site'|t('app'),
    instructions: 'The site you want to import the data into'|t('app'),
    options: availableSites,
    value: old('settings.site', import.site) ?? Sites.getPrimarySite().handle,
    errors: errors.get('settings.site'),
    data: {'error-key': 'settings.site'},
    disabled: readOnly,
    static: static,
}) }}

{{ forms.selectField({
    id: 'elementType',
    name: 'elementType',
    label: 'Element Type'|t('app'),
    instructions: 'The element type this import is for.'|t('app'),
    options: availableElementTypes,
    value: old('settings.elementType') ?? defaultElementType,
    errors: errors.get('settings.className'),
    data: {'error-key': 'settings.elementType'},
    disabled: readOnly,
    static: static,
}) }}

{{ forms.textField({
    label: "Transformer"|t('app'),
    instructions: "The class name (with namespace) of the transformer you’d like to use."|t('app'),
    id: 'transformer',
    name: 'transformer',
    class: 'code',
    autocorrect: false,
    autocapitalize: false,
    maxlength: 255,
    value:  import ? old('settings.transformer', import.usesDefaultTransformer() ? null : import.transformerAsString()) : null,
    required: false,
    errors: errors.get('settings.transformer'),
    data: {'error-key': 'settings.transformer'},
    disabled: readOnly,
    placeholder: 'CraftCms\\Cms\\Import\\Transformers\\ElementTransformer',
    static: static,
}) }}


{# for element types that can have multiple field layout providers (like Entries) we now go to an field layout provider screen
    and then from that screen to the mapping one;
#}
<a href="{{ cpUrl('import/configs/' ~ import.handle ~ '/field-layout-provider') }}" class="btn submit">Configure field layout provider</a>
