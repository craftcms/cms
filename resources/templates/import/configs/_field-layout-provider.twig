{% import '_includes/forms.twig' as forms %}

{% set readOnly = readOnly ?? false %}
{% set static = static ?? false %}

{{ forms.hidden({
    name: 'uid',
    value: import.uid
}) }}

{{ forms.selectField({
    label: 'Choose the field layout provider to import into (e.g. entry type, volume)',
    name: 'fieldLayout',
    options: availableFieldLayoutProviders,
    value: old('fieldLayout', import.fieldLayout ?? null),
    errors: errors.get('fieldLayout'),
    data: {'error-key': 'fieldLayout'},
    disabled: readOnly,
    static: static,
}) }}
