{% js %}
$('.mapping-slideout').on('activate', function(e) {
    e.preventDefault();

    const fieldUid = $(this).data('field-uid');
    const fieldHandle = $(this).data('field-handle');
    const importUid = $(this).data('import-uid');
    const ownerPrefix = $(this).data('owner-prefix');

    console.log(ownerPrefix);

    let data;
    try {
        const slideout = new Craft.CpScreenSlideout(
            'import/configs/editNestedFieldMapping',
            {
                params: {'fieldUid': fieldUid, 'fieldHandle': fieldHandle, 'importUid': importUid, 'ownerPrefix': ownerPrefix},
            }
        );
        slideout.on('submit', (ev) => {
            const data = ev.response.data;
            let $input = $(this).prev('input[name$="' + ownerPrefix + '"]');
    console.log($input);
    console.log(data.map);
            $input.val(JSON.stringify(data.map));
        });
{#        slideout.on('close', () => {#}
{#            slideout.destroy();#}
{#        });#}
    } catch (e) {
        Craft.cp.displayError(e?.response?.data?.message);
        throw e;
    }
});
{% endjs %}
