{% import '_includes/forms.twig' as forms %}

{% set readOnly = readOnly ?? false %}
{% set nested = nested ?? false %}
{% set field = field ?? null %}
{% set fieldHandle = fieldHandle ?? null %}

<p>File: {{ import.file }}</p>

{% if not readOnly %}
    {{ hiddenInput('importUid', import.uid) }}
    {% if field %}
        {{ hiddenInput('fieldUid', field.uid) }}
    {% endif %}
    {% if fieldHandle %}
        {{ hiddenInput('fieldHandle', fieldHandle) }}
    {% endif %}
{% endif %}

{% if nested %}
    {% if canKeepMissingNestedElements ?? false %}
        {{ forms.checkboxField({
            name: prefixedHandleForKeepFlag,
            label: 'Keep existing nested elements missing from the imported data.'|t('app'),
            checked: keepMissingNestedElementsChecked ?? false,
            value: 1,
            errors: errors.get(prefixedHandleForKeepFlag),
            data: {'error-key': prefixedHandleForKeepFlag},
            disabled: readOnly,
            static: static,
        }) }}
    {% endif %}
    {% for item in destinationCols %}
        <h3>{{ item.provider.name ?? field.name ?? 'Nested Field Mapping' }}</h3>
        {{ _self.fieldLayoutTable(item.destinationCols, sourceDataCols, import, field, readOnly, static) }}
    {% endfor %}
{% else %}
    {{ _self.fieldLayoutTable(destinationCols, sourceDataCols, import, null, readOnly, static) }}
{% endif %}




{# ---------------------- MACROS ---------------------- #}

{% macro fieldLayoutTable(destinationCols, sourceDataCols, import, field = null, readOnly, static) %}
    <table>
        {% for col in destinationCols %}
            {% if col.multiple is defined and col.multiple == true %}
                <th>
                    <td colspan="2">
                        <strong>{{ col.heading ?? 'Field' }}</strong>
                    </td>
                </th>
                {% for subcol in col.subfields %}
                    {{ _self.row(subcol, import, sourceDataCols, readOnly, static) }}
                {% endfor %}
            {% elseif col is not empty %}
                {{ _self.row(col, import, sourceDataCols, readOnly, static) }}
            {% endif %}
        {% endfor %}
    </table>
{% endmacro %}


{% macro row(col, import, sourceDataCols, readOnly, static) %}
    <tr>
        <td>
            {{ col.label }} <pre>({{ col.handle }})</pre>
        </td>
        <td>
            {% set nestedSources = {
                map: import.map,
                matchCriteria: import.matchCriteria,
                clear: import.clearableItems,
                keep: import.keepMissingNestedElements,
            } %}
            {% set nestedValues = {} %}
            {% for key, source in nestedSources %}
                {% set nestedValues = nestedValues|merge({
                    (key): source ? col.prefixedHandleAsArray|reduce(
                        (value, part) => (value and value is iterable and value[part] is defined) ? attribute(value, part) : null,
                        source
                    ) : null,
                }) %}
            {% endfor %}

            {% set nestedFieldValueForMap = nestedValues.map %}
            {% set nestedFieldValueForMatchCriteria = nestedValues.matchCriteria is not null ? nestedValues.matchCriteria|boolean : null %}
            {% set nestedFieldValueForClear = nestedValues.clear is not null ? nestedValues.clear|boolean : null %}
            {% set nestedFieldValueForKeep = nestedValues.keep %}

            {% if col.isContainer %}
                {{ hiddenInput(
                    col.prefixedHandleForMap,
                    nestedFieldValueForMap ? nestedFieldValueForMap|json_encode : null
                ) }}
                {{ hiddenInput(
                    col.prefixedHandleForMatchCriteria,
                    nestedFieldValueForMatchCriteria ? nestedFieldValueForMatchCriteria|json_encode : null
                ) }}
                {{ hiddenInput(
                    col.prefixedHandleForClear,
                    nestedFieldValueForClear ? nestedFieldValueForClear|json_encode : null
                ) }}
                {{ hiddenInput(
                    col.prefixedHandleForKeep,
                    nestedFieldValueForKeep is not null ? nestedFieldValueForKeep|json_encode : null
                ) }}
                <a href="#"
                   class="btn mapping-slideout"
                   data-field-uid="{{ col.fieldUid ?? '' }}" {# this is the global field UID #}
                   data-field-handle="{{ col.prefixedHandle }}" {# this will be the layout handle, so can be the overwritten one #}
                   data-field-is-property="{{ col.isProperty ?? false }}" {# this will be the layout handle, so can be the overwritten one #}
                   data-import-uid="{{ import.uid }}"
                   data-field-can-keep-missing="{{ col.canKeepMissingNestedElements ?? false }}"
                   data-field-keep-name="{{ col.prefixedHandleForKeepFlag ?? '' }}"
                >
                    Map field
                </a>

                {#{{ dump(col) }}#}
            {% else %}
                {{ forms.selectField({
                    name: col.prefixedHandleForMap,
                    options: sourceDataCols,
                    value: nestedFieldValueForMap,
                    errors: errors.get(col.prefixedHandleForMap),
                    data: {'error-key': col.prefixedHandleForMap},
                    disabled: readOnly,
                    static: static,
                }) }}

                {% if col.canBeMatchCriteria ?? false %}
                    {{ forms.checkboxField({
                        name: col.prefixedHandleForMatchCriteria,
                        label: 'Use this field’s value to match against an existing element.'|t('app'),
                        checked: nestedFieldValueForMatchCriteria ?? false,
                        value: 1,
                        errors: errors.get(col.prefixedHandleForMatchCriteria),
                        data: {'error-key': col.prefixedHandleForMatchCriteria},
                        disabled: readOnly,
                        static: static,
                    }) }}
                {% endif %}

                {% if col.canBeCleared ?? false %}
                    {{ forms.checkboxField({
                        name: col.prefixedHandleForClear,
                        label: 'Clear existing value if no data provided or provided value is empty.'|t('app'),
                        checked: nestedFieldValueForClear ?? false,
                        value: 1,
                        errors: errors.get(col.prefixedHandleForClear),
                        data: {'error-key': col.prefixedHandleForClear},
                        disabled: readOnly,
                        static: static,
                    }) }}
                {% endif %}
                {#{{ dump(col) }}#}
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{#{{ dump(destinationCols) }}#}
{#{{ dump(sourceDataCols) }}#}


{# TODO: this whole thing will move to a separate file #}
{% js %}
$('.mapping-slideout').on('activate', function(e) {
    e.preventDefault();

    const fieldUid = $(this).data('field-uid');
    const fieldHandle = $(this).data('field-handle');
    const fieldIsProperty = $(this).data('field-is-property');
    const importUid = $(this).data('import-uid');
    const fieldCanKeepMissing = $(this).data('field-can-keep-missing');
    const fieldKeepName = $(this).data('field-keep-name');
    let $mapInput = $(this).prevAll('input[type="hidden"][name^="map["], input[type="hidden"][name*="[map]["]');
    let $matchCriteriaInput = $(this).prevAll('input[type="hidden"][name^="matchCriteria["], input[type="hidden"][name*="[matchCriteria]["]');
    let $clearableItemsInput = $(this).prevAll('input[type="hidden"][name^="clearableItems["], input[type="hidden"][name*="[clearableItems]["]');
    let $keepInput = $(this).prevAll('input[type="hidden"][name^="keepMissingNestedElements["], input[type="hidden"][name*="[keepMissingNestedElements]["]');
    let data;

    try {
        const slideout = new Craft.CpScreenSlideout(
            'import/configs/editNestedFieldMapping',
            {
                params: {
                    'fieldUid': fieldUid,
                    'fieldHandle': fieldHandle,
                    'fieldIsProperty': fieldIsProperty,
                    'importUid': importUid,
                    'currentMap': $mapInput.val(),
                    'currentMatchCriteria': $matchCriteriaInput.val(),
                    'currentClearableItems': $clearableItemsInput.val(),
                    'fieldCanKeepMissing': fieldCanKeepMissing,
                    'fieldKeepName': fieldKeepName,
                    'currentKeepMissingNestedElements': $keepInput.val(),
                },
            }
        );
        slideout.on('submit', (ev) => {
            const data = ev.response.data;

            $mapInput.val(JSON.stringify(data.map));
            $matchCriteriaInput.val(JSON.stringify(data.matchCriteria));
            $clearableItemsInput.val(JSON.stringify(data.clearableItems));
            $keepInput.val(JSON.stringify(data.keepMissingNestedElements));
        });
{#        slideout.on('close', () => {#}
{#            slideout.destroy();#}
{#        });#}
    } catch (e) {
        Craft.cp.displayError(e?.response?.data?.message);
        throw e;
    }
});
{% endjs %}
