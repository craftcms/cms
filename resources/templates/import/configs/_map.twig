{% import '_includes/forms.twig' as forms %}

{% set readOnly = readOnly ?? false %}
{% set nested = nested ?? false %}
{% set field = field ?? null %}
{% set fieldHandle = fieldHandle ?? null %}

<p>File: {{ import.file }}</p>

{% if not readOnly %}
    {{ hiddenInput('importUid', import.uid) }}
    {% if field %}
        {{ hiddenInput('fieldUid', field.uid) }}
    {% endif %}
    {% if fieldHandle %}
        {{ hiddenInput('fieldHandle', fieldHandle) }}
    {% endif %}
{% endif %}

{% if nested %}
    {% for item in destinationCols %}
        <h3>{{ item.provider.name ?? field.name ?? 'Nested Field Mapping' }}</h3>
        {{ _self.fieldLayoutTable(item.destinationCols, sourceDataCols, import, field) }}
    {% endfor %}
{% else %}
    {{ _self.fieldLayoutTable(destinationCols, sourceDataCols, import) }}
{% endif %}


{% macro fieldLayoutTable(destinationCols, sourceDataCols, import, field = null) %}
    <table>
        {% for col in destinationCols %}
            {% if col.multiple is defined and col.multiple == true %}
                <th>
                    <td colspan="2">
                        <strong>{{ col.heading ?? 'Field' }}</strong>
                    </td>
                </th>
                {% for subcol in col.subfields %}
                    {{ _self.row(subcol, import, sourceDataCols) }}
                {% endfor %}
            {% elseif col is not empty %}
                {{ _self.row(col, import, sourceDataCols) }}
            {% endif %}
        {% endfor %}
    </table>
{% endmacro %}

{% macro row(col, import, sourceDataCols) %}
    <tr>
        <td>
            {{ col.label }} <pre>({{ col.handle }})</pre>
        </td>
        <td>
            {% if col.isContainer %}
                {{ hiddenInput(col.prefixedHandle, null) }}
                <a href="#"
                   class="btn mapping-slideout"
                   data-field-uid="{{ col.fieldUid ?? '' }}" {# this is the global field UID #}
                   data-field-handle="{{ col.handle }}" {# this will be the layout handle, so can be overwritten #}
                   data-import-uid="{{ import.uid }}"
                   data-owner-prefix="{{ col.prefixedHandle }}"
                >
                    Map field
                </a>

                {{ col.prefixedHandle }}
            {% else %}
                {{ forms.selectField({
                    name: col.prefixedHandle,
                    options: sourceDataCols,
                    value: col.prefixedHandleWithoutMap|reduce(
                        (value, part) => attribute(value, part),
                        import.map
                    )
                }) }}
            {% endif %}
        </td>
    </tr>
{% endmacro %}

