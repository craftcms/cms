{% extends "_layouts/elementindex" %}
{% set page = page ?? null %}

{% if not page or not ElementSources.pageExists("CraftCms\\Cms\\Entry\\Elements\\Entry", page) %}
  {% if sectionHandle is defined %}
    {% set redirect = Sections.getSectionByHandle(sectionHandle).getCpIndexUri() ?? null %}
    {% if redirect and redirect != Request.decodedPath() %}
      {% redirect redirect %}
    {% endif %}
  {% endif %}

  {% set firstPage = ElementSources.getFirstPage("CraftCms\\Cms\\Entry\\Elements\\Entry") %}
  {% if firstPage or page != 'entries' %}
    {% redirect 'content/' ~ (firstPage ? firstPage|kebab : 'entries') %}
  {% endif %}
{% endif %}

{% set title = "Entries"|t('app') %}
{% set elementType = 'CraftCms\\Cms\\Entry\\Elements\\Entry' %}

{% if sectionHandle is defined %}
  {% js %}
    window.defaultSectionHandle = "{{ sectionHandle|e('js') }}";
  {% endjs %}
{% endif %}
