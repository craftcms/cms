<div>
  {% if entries|length %}
    <ol>
      {% for entry in entries %}
        <li class="tw:py-0.5">
          <a href="{{ entry.getCpEditUrl() }}">{{ entry.title }}</a> <span class="tw:text-muted">
            <relative-time datetime="{{ entry.dateCreated|date('c') }}" format="datetime">
              {{ entry.dateCreated|timestamp('short') }}
            </relative-time>
            {%- if CraftEdition != CraftSolo and entry.getAuthor() %}, {{ entry.getAuthor().username }}{% endif -%}
          </span>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="tw:text-sm">{{ "No entries exist yet."|t('app') }}</p>
  {% endif %}
</div>
