{% import "_includes/forms" as forms %}

{% macro numberField(config) %}
    {% from '_includes/forms' import textField %}
    {# Only format the value if it isn’t going to be misrepresented #}
    {% if not I18N.getFormatter().willBeMisrepresented(config.value) %}
        {{ hiddenInput("#{config.name}[locale]", I18N.formattingLocale.id) }}
        {% set config = config|merge({
            name: "#{config.name}[value]",
            value: config.value|number,
        }) %}
    {% endif %}
    {{ textField(config) }}
{% endmacro %}

{{ _self.numberField({
    label: 'Min Value'|t('app'),
    id: 'min',
    name: 'min',
    value: field.min,
    size: 5,
    required: true,
    errors: field.errors.get('min'),
    data: {'error-key': 'min'},
    disabled: readOnly,
}) }}

{{ _self.numberField({
    label: 'Max Value'|t('app'),
    id: 'max',
    name: 'max',
    value: field.max,
    size: 5,
    required: true,
    errors: field.errors.get('max'),
    data: {'error-key': 'max'},
    disabled: readOnly,
}) }}

{{ _self.numberField({
