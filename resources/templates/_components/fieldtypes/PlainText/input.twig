{%- set disabled = disabled ?? false %}
{%- set maxlength = not disabled ? field.charLimit : null %}

{%- set class = [
    'nicetext',
    field.code ? 'code',
    field.uiMode == 'enlarged' ? 'readable',
]|filter %}

{% if field.multiline %}
    {{ ui('textarea', {
        id: id ?? field.getInputId(),
        describedBy: field.describedBy ?: null,
        name: name,
        value: value,
        maxlength: maxlength,
        showCharsLeft: true,
        placeholder: placeholder,
        rows: field.initialRows,
        disabled,
        inputAttributes: {class: class},
    }) }}
{% else %}
    {{ ui('input', {
        id: id ?? field.getInputId(),
        describedBy: field.describedBy ?: null,
        name: name,
        value: value,
        maxlength: maxlength,
        width: maxlength ? 'full' : null,
        showCharsLeft: true,
        placeholder: placeholder,
        orientation: orientation ?? null,
        disabled,
        inputAttributes: {class: class},
    }) }}
{% endif %}
