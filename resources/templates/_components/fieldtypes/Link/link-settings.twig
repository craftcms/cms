{% import '_includes/forms' as forms %}
{% set namespace = namespace ?? null %}
{% set typesName = namespace ? "#{namespace}[types]" : 'types' %}
{% set showLabelFieldName = namespace ? "#{namespace}[showLabelField]" : 'showLabelField' %}
{% set advancedFieldsName = namespace ? "#{namespace}[advancedFields]" : 'advancedFields' %}
{% set allowedTypesErrors = namespace ? field.errors.get("#{namespace}Types") : field.errors.get('types') %}
{% set showLabelFieldErrors = namespace ? field.errors.get("#{namespace}ShowLabelField") : field.errors.get('showLabelField') %}
{% set advancedFieldsErrors = namespace ? field.errors.get("#{namespace}AdvancedFields") : field.errors.get('advancedFields') %}

{{ forms.checkboxSelectField({
    label: 'Allowed Link Types'|t('app'),
    instructions: 'The link types that should be available when inserting links.'|t('app'),
    id: 'types',
    fieldClass: 'mb-0',
    name: typesName,
    options: linkTypeOptions,
    values: allowedTypes,
    targetPrefix: 'types-',
    sortable: true,
    required: true,
    errors: allowedTypesErrors ?? null,
    disabled: readOnly,
}) }}

{% for typeId, settings in linkTypeSettings %}
    <div id="types-{{ typeId }}" class="{{ typeId not in allowedTypes ? 'hidden' }} pt-s">
        <hr>
        <a class="fieldtoggle mt-s mb-s" data-target="types-{{ typeId }}-settings">{{ settings.label }}</a>
        <div id="types-{{ typeId }}-settings" class="hidden indent">
            {{ settings.html|raw }}
        </div>
    </div>
{% endfor %}

<hr>

{{ forms.lightswitchField({
    label: 'Show the “Label” field'|t('app'),
    id: 'showLabelField',
    name: showLabelFieldName,
    on: showLabelField,
    errors: showLabelFieldErrors ?? null,
    disabled: readOnly,
}) }}

<hr>

{{ forms.checkboxSelectField({
    label: 'Advanced Fields'|t('app'),
    instructions: 'Choose which advanced fields should be available when inserting links.'|t('app'),
    id: 'advancedFields',
    name: advancedFieldsName,
    options: advancedFieldOptions,
    values: advancedFields,
    sortable: true,
    errors: advancedFieldsErrors ?? null,
    disabled: readOnly,
}) }}
