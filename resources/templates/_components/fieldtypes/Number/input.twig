
{%- set id = id ?? field.getInputId() %}
{%- set descriptionId = descriptionId ?? "#{id}-desc" %}
{%- set prefix = field.prefix ?? false %}
{%- set suffix = field.suffix ?? false %}
{%- set hasPrefix = prefix is not same as(false) %}
{%- set hasSuffix = suffix is not same as(false) %}
{%- set currencyLabel = currencyLabel ?? false %}

{% if formatNumber %}
    {{ hiddenInput("#{field.handle}[locale]", I18N.formattingLocale.id) }}
{% endif %}

{% if hasPrefix or hasSuffix %}
    {{ tag('span', {
        id: descriptionId,
        class: 'visually-hidden',
        text: [
            hasPrefix ? 'Value prefixed by “{prefix}”.'|t('app', {prefix: prefix|t('site')}),
            hasSuffix ? 'Value suffixed by “{suffix}”.'|t('app', {suffix: suffix|t('site')}),
        ]|filter|join(' '),
    }) }}
{% endif %}

<div class="flex">
    {% if hasPrefix %}
        <div aria-hidden="true">
            {{ prefix|t('site')|md(inlineOnly=true,encode=true)|raw }}
        </div>
    {% endif %}
    <div class="number-container">
        {% if currencyLabel %}
            <div class="number-currency-label">
                <span>{{ currencyLabel }}</span>
            </div>
        {% endif %}

        {% set isNumber = field.step ? true : false %}
        {{ ui('input', {
            type: isNumber ? 'number' : 'text',
            id: id,
            name: formatNumber ? "#{field.handle}[value]" : field.handle,
            value: value,
            inputmode: field.decimals ? 'decimal' : 'numeric',
            step: field.step ?: null,
            min: isNumber ? field.min : null,
            max: isNumber ? field.max : null,
            inputSize: field.size ?: null,
            width: field.size ? 'auto' : null,
            describedBy: [describedBy ?? null, hasPrefix or hasSuffix ? descriptionId : null]|filter|join(' ') ?: null,
        }) }}
    </div>
    {% if hasSuffix %}
        <div aria-hidden="true">
            {{ suffix|t('site')|md(inlineOnly=true,encode=true)|raw }}
        </div>
    {% endif %}
</div>
