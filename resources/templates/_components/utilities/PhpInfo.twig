<div class="p-4 grid gap-8">
  {% for section, values in phpInfo %}
    <div id="{{ section | id }}">
      <h2 class="mb-2">{{ section }}</h2>
      <table class="cp-table cp-table--borderless">
        <tbody>
          {% for key, value in values %}
            <tr>
              <th class="light">{{ key|raw }}</th>
              <td>
                {%- if value is iterable %}
                  {{- value|join(', ') }}
                {%- else %}
                  {{- value }}
                {%- endif -%}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
