<div class="cp:p-4 cp:grid cp:gap-8">
  {% for section, values in phpInfo %}
    <div id="{{ section | id }}">
      <h2 class="cp:mb-2">{{ section }}</h2>
      <table class="cp-table cp-table--fixed">
        <tbody>
          {% for key, value in values %}
            <tr>
              <th class="cell">{{ key|raw }}</th>
              <td class="cell cell--wrap">
                {%- if value is iterable %}
                  {{- value|join(', ') }}
                {%- else %}
                  {{- value }}
                {%- endif -%}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
