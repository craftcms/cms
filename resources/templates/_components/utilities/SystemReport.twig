<div class="p-4 grid gap-8">
  <div id="application-info">
    <h2 class="mb-3">{{ "Application Info"|t('app') }}</h2>

    <table class="cp-table cp-table--borderless" dir="ltr">
      <tbody>
        {% for label, value in appInfo %}
          <tr>
            <th class="light">{{ label }}</th>
            <td>{{ value }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div id="plugins">

    <h2 class="mb-3">{{ "Plugins"|t('app') }}</h2>

    {% if plugins|length %}
      <table class="cp-table cp-table--borderless" dir="ltr">
        <tbody>
          {% for plugin in plugins %}
            <tr>
              <th class="light">{{ plugin.name }}</th>
              <td>{{ plugin.version }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p>{{ 'No plugins are enabled.'|t('app') }}</p>
    {% endif %}
  </div>

  <div id="aliases">

    <h2 class="mb-3">{{ 'Aliases'|t('app') }}</h2>
    <p>
      {{ 'The following <a href="{url}">aliases</a> are defined:'|t('app', {
        url: 'https://craftcms.com/docs/5.x/configure.html#aliases',
      })|raw }}
    </p>

    <table class="cp-table cp-table--borderless" dir="ltr">
      <tbody>
        {% for alias, value in aliases %}
          <tr>
            <th class="light">{{ alias }}</th>
            <td>{{ value }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div id="requirements">

    <h2 class="mb-3">{{ "Requirements"|t('app') }}</h2>

    <table class="cp-table cp-table--borderless" dir="ltr">
      <tbody>
        {% for requirement in requirements %}
          <tr>
            <td>
              <div class="flex gap-2 items-center">
                {% if requirement.error %}
                  <craft-callout
                    class="p-0"
                    appearance="plain"
                    variant="danger"
                  >
                    <craft-icon name="triangle-exclamation" slot="icon" label="{{ 'Failed'|t('app') }}"></craft-icon>
                    {{ requirement.name }}
                  </craft-callout>
                {% elseif requirement.warning %}
                  <craft-callout
                    class="p-0"
                    appearance="plain"
                    variant="warning"
                  >
                    <craft-icon
                      name="circle-exclamation"
                      slot="icon"
                      label="{{ 'Passed with warning'|t('app') }}"
                    ></craft-icon>
                    {{ requirement.name }}
                  </craft-callout>
                  <craft-icon name="alert" label="{{ 'Passed with warning'|t('app') }}"></craft-icon>
                {% else %}
                  <craft-callout
                    class="p-0"
                    appearance="plain"
                    variant="success"
                  >
                    <craft-icon name="circle-check" slot="icon" label="{{ 'Passed'|t('app') }}"></craft-icon>
                    {{ requirement.name }}
                  </craft-callout>
                {% endif %}
              </div>
            </td>

            <td>
              {{ requirement.memo|raw }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
