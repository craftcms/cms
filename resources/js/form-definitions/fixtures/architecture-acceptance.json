{
  "ordinary": {
    "elements": [
      {
        "type": "craft:field",
        "key": "ordinary-title",
        "width": 50,
        "props": {
          "label": "Title",
          "instructions": "Shown in article listings."
        },
        "children": [
          {
            "type": "craft:text-input",
            "name": "title",
            "props": {
              "placeholder": "Article title"
            },
            "attributes": {
              "autocomplete": "off"
            }
          }
        ]
      }
    ]
  },
  "conditionalVisibility": {
    "elements": [
      {
        "type": "craft:field",
        "key": "visibility-mode",
        "props": {
          "label": "Mode"
        },
        "children": [
          {
            "type": "craft:text-input",
            "name": "mode"
          }
        ]
      },
      {
        "type": "craft:field",
        "key": "visibility-details",
        "props": {
          "label": "Details"
        },
        "children": [
          {
            "type": "craft:text-input",
            "name": "details"
          }
        ],
        "visibleWhen": {
          "name": "mode",
          "operator": "equals",
          "value": "advanced"
        }
      }
    ]
  },
  "plugin": {
    "elements": [
      {
        "type": "craft:field",
        "key": "plugin-palette",
        "props": {
          "label": "Palette"
        },
        "children": [
          {
            "type": "color-tools:color-map",
            "name": "palette",
            "props": {
              "colors": ["red", "blue"]
            },
            "plugin": {
              "handle": "color-tools",
              "name": "Color Tools",
              "packageName": "vendor/color-tools"
            }
          }
        ]
      }
    ]
  },
  "fieldLayout": {
    "elements": [
      {
        "type": "craft:tabs",
        "key": "article-layout",
        "children": [
          {
            "type": "craft:tab",
            "key": "content-tab",
            "props": {
              "label": "Content"
            },
            "children": [
              {
                "type": "craft:field",
                "key": "title-layout-element",
                "width": 50,
                "props": {
                  "label": "Title"
                },
                "children": [
                  {
                    "type": "craft:text-input",
                    "name": "fields.title",
                    "props": {
                      "placeholder": "Projected title"
                    }
                  }
                ]
              },
              {
                "type": "craft:field",
                "key": "summary-layout-element",
                "width": 100,
                "props": {
                  "label": "Summary"
                },
                "children": [
                  {
                    "type": "craft:text-input",
                    "name": "fields.summary",
                    "props": {
                      "placeholder": "Projected summary"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
