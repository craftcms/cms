{
  "plugins": ["stylelint-use-logical-spec"],
  "overrides": [
    {
      "files": ["**/*.vue", "**/*.html"],
      "customSyntax": "postcss-html"
    },
    {
      "files": ["**/*.scss"],
      "customSyntax": "postcss-scss"
    },
    {
      "files": ["**/*.ts"],
      "customSyntax": "postcss-lit"
    }
  ],
  "rules": {
    "liberty/use-logical-spec": [
      "always",
      {
        "except": [
          "height",
          "width",
          "max-height",
          "min-height",
          "min-width",
          "max-width"
        ]
      }
    ],
    "selector-disallowed-list": [
      [
        "/:has\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\)|\\()*?(?::not\\(|\\*(?!=))/"
      ],
      {
        "message": "Avoid :not() and * inside :has(): Chromium then restyles the whole document whenever any element is added or removed. Match positively inside :has() and negate outside it, as in :has(a):not(:has(a.b))."
      }
    ]
  }
}
