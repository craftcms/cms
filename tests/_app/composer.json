{
  "name": "craftcms/e2e",
  "description": "Minimal Laravel app for Craft CMS browser tests",
  "type": "project",
  "license": "0BSD",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "craftcms/cms": "6.x-dev as 5.8.0",
    "craftcms/yii2-adapter": "6.x-dev as 5.8.0",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "/tmp/packages/*",
      "options": {
        "symlink": true,
        "versions": {
          "craftcms/cms": "6.x-dev",
          "craftcms/yii2-adapter": "6.x-dev"
        }
      }
    }
  ],
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
