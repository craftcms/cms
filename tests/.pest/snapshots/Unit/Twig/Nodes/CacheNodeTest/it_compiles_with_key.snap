$cacheService = Craft::$app->getTemplateCaches();
$request = Craft::$app->getRequest();
$ignoreCache2 = ($request->getIsLivePreview() || $request->getToken());
if (!$ignoreCache2) {
    $cacheKey2 = "my-cache-key";
    $cacheBody2 = $cacheService->getTemplateCache($cacheKey2, false, true);
} else {
    $cacheBody2 = null;
}
if ($cacheBody2 === null) {
    if (!$ignoreCache2) {
        $cacheService->startTemplateCache(true, false);
    }
    ob_start();
    yield "cached content";
    $cacheBody2 = ob_get_clean();
    if (!$ignoreCache2) {
        $cacheService->endTemplateCache($cacheKey2, false, null, null, $cacheBody2, true);
    }
}
yield $cacheBody2;