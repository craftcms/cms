$_namespace = "myNamespace";
if ($_namespace !== null && $_namespace !== '') {
    yield CraftCms\Cms\Support\Facades\InputNamespace::namespaceInputs(function () use (&$context, $macros, $blocks) {
        return \Twig\Extension\CoreExtension::captureOutput((function () use (&$context, $macros, $blocks) {
            yield "<input name=\"title\">";
            yield from [];
        })());
    }, $_namespace, withClasses: true);
} else {
    yield "<input name=\"title\">";
}
unset($_namespace);