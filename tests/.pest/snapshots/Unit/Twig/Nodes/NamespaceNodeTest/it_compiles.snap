$_namespace = "myNamespace";
if ($_namespace !== null && $_namespace !== '') {
    $_originalNamespace = CraftCms\Cms\Support\Facades\InputNamespace::get();
    CraftCms\Cms\Support\Facades\InputNamespace::set(CraftCms\Cms\Support\Facades\InputNamespace::namespaceInputName($_namespace));
    ob_start();
    try {
        yield "<input name=\"title\">";
    } catch (Exception $e) {
        ob_end_clean();

        throw $e;
    }
    yield CraftCms\Cms\Support\Html::namespaceHtml(ob_get_clean(), $_namespace, false);
    CraftCms\Cms\Support\Facades\InputNamespace::set($_originalNamespace);
} else {
    yield "<input name=\"title\">";
}
unset($_originalNamespace, $_namespace);