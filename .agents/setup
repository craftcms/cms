#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export CI=true COMPOSER_NO_INTERACTION=1 COMPOSER_ROOT_VERSION=6.x-dev
TIMEFORMAT='Finished in %3R seconds'

step() {
    printf '\n==> %s\n' "$1"
    shift
    time "$@"
}

scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT

# Debian's default PHP is too old. Use the upstream Sury Debian packages.
if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
    curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$scratch/sury.deb"
    sudo dpkg -i "$scratch/sury.deb"
fi
if [[ ! -f /etc/apt/sources.list.d/php.list ]]; then
    . /etc/os-release
    echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $VERSION_CODENAME main" |
        sudo tee /etc/apt/sources.list.d/php.list >/dev/null
fi

# Use Oracle MySQL, not Debian's MariaDB substitute, for MySQL-specific bugs.
if [[ ! -f /usr/share/keyrings/craft-mysql.asc ]]; then
    curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 -o "$scratch/mysql.asc"
    sudo install -m 644 "$scratch/mysql.asc" /usr/share/keyrings/craft-mysql.asc
fi
if [[ ! -f /etc/apt/sources.list.d/craft-mysql.list ]]; then
    echo 'deb [signed-by=/usr/share/keyrings/craft-mysql.asc] https://repo.mysql.com/apt/debian/ bookworm mysql-8.4-lts' |
        sudo tee /etc/apt/sources.list.d/craft-mysql.list >/dev/null
fi

# Backups shell out to the sqlite3 CLI. intl is installed below instead.
packages=(php8.5-cli php8.5-bcmath php8.5-curl php8.5-gd
    php8.5-mbstring php8.5-mysql php8.5-pgsql php8.5-sqlite3 php8.5-xml
    php8.5-zip php8.5-soap php8.5-imagick libvips42 unzip sqlite3 zstd
    mysql-community-server-core mysql-community-client-core postgresql-15)
missing=()
for package in "${packages[@]}"; do
    if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    step 'Refresh apt indexes' sudo apt-get update -qq
    step 'Install PHP, database engines, and image libraries' sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
sudo update-alternatives --set php /usr/bin/php8.5

# CI's ubuntu-24.04 PHP links intl against ICU 74.2, and date formats differ
# across ICU versions. Debian's php8.5-intl uses ICU 72, so install the same
# prebuilt ICU/intl pair setup-php uses. The ICU libraries find each other
# through the loader path; their .74 sonames don't clash with Debian's ICU.
icu_version=74.2
if [[ $(php -r 'echo defined("INTL_ICU_VERSION") ? INTL_ICU_VERSION : "";') != "$icu_version" ]]; then
    if dpkg-query -W php8.5-intl >/dev/null 2>&1; then
        sudo env DEBIAN_FRONTEND=noninteractive apt-get purge -y php8.5-intl
    fi
    case $(uname -m) in
        x86_64) icu_arch= ;;
        aarch64) icu_arch=-arm64 ;;
        *) echo 'Unsupported ICU architecture' >&2; exit 1 ;;
    esac
    icu_url=https://github.com/shivammathur/icu-intl/releases/download
    curl -fsSL "$icu_url/icu4c/icu4c-$icu_version$icu_arch.tar.zst" -o "$scratch/icu.tar.zst"
    curl -fsSL "$icu_url/intl-$icu_version/php8.5-intl-$icu_version$icu_arch.so" -o "$scratch/intl.so"
    sudo rm -rf /usr/local/icu
    sudo tar -I zstd -xf "$scratch/icu.tar.zst" -C /usr/local
    echo /usr/local/icu/lib | sudo tee /etc/ld.so.conf.d/icu.conf >/dev/null
    sudo ldconfig
    intl_extension="$(php -r 'echo PHP_EXTENSION_DIR;')/intl-icu$icu_version.so"
    sudo install -m 644 "$scratch/intl.so" "$intl_extension"
    echo "extension=$intl_extension" | sudo tee /etc/php/8.5/mods-available/intl-icu.ini >/dev/null
    sudo phpenmod -v 8.5 intl-icu
fi

# Prevent Debian's unused system cluster from claiming port 5432 after restore.
if [[ -f /etc/postgresql/15/main/start.conf ]] && ! grep -qx manual /etc/postgresql/15/main/start.conf; then
    echo manual | sudo tee /etc/postgresql/15/main/start.conf >/dev/null
fi

# Initialize private, disposable databases, but leave starting them to Amp's
# service supervisor. Never reinitialize data restored from an existing orb.
mkdir -p .amp/databases
if [[ ! -d .amp/databases/mysql/mysql ]]; then
    step 'Initialize MySQL' /usr/sbin/mysqld --no-defaults --initialize-insecure --datadir="$PWD/.amp/databases/mysql"
fi
if [[ ! -f .amp/databases/pgsql/PG_VERSION ]]; then
    step 'Initialize PostgreSQL' /usr/lib/postgresql/15/bin/initdb -D .amp/databases/pgsql --username=root --auth=trust --encoding=UTF8 --locale=C.UTF-8
fi

# Install to the standard PATH so later non-interactive shells see the same tools.
# Unpacking over the base image's Node used to leave its older npm modules
# behind, which crashes npm commands that touch the cache (npx included);
# `npm ls` detects such a tree.
node_major=$(tr -d '[:space:]' < .node-version)
if [[ $(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true) != "$node_major" ]] ||
    ! npm ls --global --depth=0 >/dev/null 2>&1; then
    case $(uname -m) in
        x86_64) node_arch=x64 ;;
        aarch64) node_arch=arm64 ;;
        *) echo 'Unsupported Node architecture' >&2; exit 1 ;;
    esac
    curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/SHASUMS256.txt" -o "$scratch/SHASUMS256.txt"
    archive=$(awk -v arch="linux-$node_arch.tar.xz" '$2 ~ arch "$" {print $2}' "$scratch/SHASUMS256.txt")
    curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/$archive" -o "$scratch/$archive"
    (cd "$scratch"; grep " $archive$" SHASUMS256.txt | sha256sum --check)
    sudo rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack
    sudo tar -xJf "$scratch/$archive" -C /usr/local --strip-components=1
fi
pnpm_version=$(node -p 'require("./package.json").packageManager.split("@")[1]')
if [[ $(pnpm --version 2>/dev/null || true) != "$pnpm_version" ]]; then
    step 'Install pinned pnpm' sudo npm install --global "pnpm@$pnpm_version"
fi
if ! command -v composer >/dev/null; then
    curl -fsSL https://getcomposer.org/installer -o "$scratch/composer-setup.php"
    expected=$(curl -fsSL https://composer.github.io/installer.sig)
    actual=$(php -r 'echo hash_file("sha384", $argv[1]);' "$scratch/composer-setup.php")
    [[ "$actual" == "$expected" ]] || { echo 'Composer installer checksum mismatch' >&2; exit 1; }
    php "$scratch/composer-setup.php" --2 --install-dir="$scratch" --filename=composer
    sudo install -m 755 "$scratch/composer" /usr/local/bin/composer
fi

step 'Install core PHP dependencies' composer install --prefer-dist --no-interaction --no-progress
step 'Install adapter PHP dependencies' composer --working-dir=yii2-adapter install --prefer-dist --no-interaction --no-progress

# Keep registry credentials out of the repository. Supply
# CRAFT_FONTAWESOME_TOKEN as an Amp project secret for cold installs.
if [[ -n ${CRAFT_FONTAWESOME_TOKEN:-} ]]; then
    pnpm config set '//npm.fontawesome.com/:_authToken' "$CRAFT_FONTAWESOME_TOKEN"
fi
step 'Install frontend dependencies' pnpm install --prefer-offline --frozen-lockfile --trust-lockfile
# pnpm remembers skipped optional dependencies from an unauthenticated install.
if [[ -n ${CRAFT_FONTAWESOME_TOKEN:-} && ! -f node_modules/@awesome.me/kit-ddaed3f5c5/icons/metadata/icons.json ]]; then
    step 'Retry private kit installation' pnpm --config.optimisticRepeatInstall=false install --prefer-offline --frozen-lockfile --trust-lockfile
fi

# SQLite needs no daemon and these files survive snapshot activation/resume.
[[ -f tests/.env ]] || cp tests/.env.example.sqlite tests/.env
[[ -f database/craft_tests.sqlite ]] || touch database/craft_tests.sqlite
[[ -f workbench/.env ]] || cp workbench/.env.example workbench/.env

if [[ ! -f node_modules/@awesome.me/kit-ddaed3f5c5/icons/metadata/icons.json ]]; then
    echo 'Missing Font Awesome kit. Add CRAFT_FONTAWESOME_TOKEN to Amp project secrets, then rerun setup.' >&2
    exit 1
fi
step 'Copy icons' composer copy-icons
# Build hooks format tracked source; setup should only generate build artifacts.
# Keep the same order as build:all, invoking packages directly to disable hooks.
for package in @craftcms/garnish @craftcms/ui @craftcms/legacy; do
    step "Build $package" pnpm --config.enablePrePostScripts=false --filter "$package" run build
done
step 'Build control panel' pnpm --config.enablePrePostScripts=false run build
step 'Generate Custom Elements Manifest' pnpm --filter @craftcms/ui run build:manifest
step 'Install test browser' pnpm exec playwright install --with-deps --only-shell chromium

# Orbs start from 6.x, so Craft 5 threads would otherwise spend a minute or more
# installing 5.x's npm/webpack toolchain. Keep a ready 5.x worktree beside this
# checkout. HUSKY=0 stops 5.x's prepare script from pointing the shared
# core.hooksPath at .husky/_, which would disable this checkout's hooks.
craft5=$(realpath -m ../cms-5.x)
# Fetch shallowly only into a shallow checkout; --depth would re-shallow full history.
fetch_depth=()
if [[ $(git rev-parse --is-shallow-repository) == true ]]; then
    fetch_depth=(--depth=1)
fi
step 'Fetch 5.x' git fetch --quiet "${fetch_depth[@]}" origin +5.x:refs/remotes/origin/5.x
if [[ ! -d $craft5 ]]; then
    git worktree add --quiet --detach "$craft5" origin/5.x
else
    git -C "$craft5" checkout --quiet --force --detach origin/5.x
fi
step 'Install Craft 5 PHP dependencies' env COMPOSER_ROOT_VERSION=5.x-dev composer --working-dir="$craft5" install --prefer-dist --no-interaction --no-progress
# npm ci always reinstalls from scratch, so skip it while the lockfile is unchanged.
if [[ ! -f $craft5/node_modules/.package-lock.json || $craft5/package-lock.json -nt $craft5/node_modules/.package-lock.json ]]; then
    step 'Install Craft 5 frontend dependencies' env HUSKY=0 npm --prefix "$craft5" ci --no-audit --no-fund
fi
guidance_marker='# Craft 5 worktree'
if ! grep -Fqx "$guidance_marker" ~/.config/amp/AGENTS.md 2>/dev/null; then
    mkdir -p ~/.config/amp
    cat >> ~/.config/amp/AGENTS.md <<EOF

$guidance_marker

- For Craft 5 work (the 5.x branch or PRs against it), use the worktree at $craft5 instead of switching this checkout. Its Composer and npm dependencies are already installed. Run \`git fetch origin 5.x\` there and create your branch from \`origin/5.x\`. Rerun \`HUSKY=0 npm ci\` only if package-lock.json changed.
- 5.x commits compiled assets. After changing a bundle's \`src/\`, rebuild only that bundle, for example \`npx webpack --node-env=production --config-name=cp\`, and commit its \`dist/\` changes.
EOF
fi

printf '\nOrb toolchain, dependencies, and assets are ready.\n'
